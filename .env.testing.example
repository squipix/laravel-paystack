# Rename this file to .env.testing and supply necessary values for integration testing.
# Integration tests are skipped unless this is true.
PAYSTACK_RUN_INTEGRATION_TESTS=false

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
MERCHANT_EMAIL=''

# Optional retry settings
PAYSTACK_RETRY_ATTEMPTS=3
PAYSTACK_RETRY_DELAY=150